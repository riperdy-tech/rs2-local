# Template for searxng/settings.yml — copy to settings.yml and set your own key.
# The real file is gitignored because secret_key is an instance secret.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
server:
  secret_key: "REPLACE_ME_WITH_A_RANDOM_64_HEX_STRING"
search:
  formats:
    - html
    - json
