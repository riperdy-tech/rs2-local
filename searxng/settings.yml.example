# Template for searxng/settings.yml — copy to settings.yml and set your own key.
# The real file is gitignored because secret_key is an instance secret.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
#
# APPLYING CHANGES: this directory IS the container's /etc/searxng (bind-mounted), so edit
# settings.yml here and `docker restart searxng`. limiter.toml must stay present — the mount
# covers the whole directory, so a file missing here is missing in the container. If the
# container is ever recreated from Git Bash, prefix with MSYS_NO_PATHCONV=1 or the mount is
# mangled into "…/searxng;C" -> "/Program Files/Git/etc/searxng" and silently ignored.
#
# RS2 Local SearXNG instance.
#
# ENGINE SELECTION (2026-08-07, measured — do not edit from memory, re-probe).
# The stock engine set returned ZERO results for real queries while the container answered
# HTTP 200, which is how 2,676 subqueries hit a 100% zero-source rate and 129 of 257 briefs
# ended up as uncited model recall. Every engine below was probed INDIVIDUALLY against this
# instance with two realistic finance queries, trusting only probes where the engine under test
# was absent from unresponsive_engines — an unknown or failed engine silently falls back to the
# default set and otherwise reads as a pass.
#
# RESULT COUNT IS NOT QUALITY. reloado scored the HIGHEST count of anything tested (62 over two
# queries) and returns German TV schedules (zdf.de) for "micron memory pricing outlook" — it is
# excluded. resulthunter (40 -> 0) and privacywall (20 -> 0) flipped between probe rounds and are
# excluded as unstable. Sample the URLs, not the count, before adding anything here.
#
# SERVING, with what they actually returned for "micron memory pricing outlook 2026":
#   dogpile news  Yahoo Finance / Benzinga / Yahoo Finance   <- best financial news of the set
#   gabanza       micron.com / Yahoo Finance
#   yandex        intellectia / 247wallst / TheStreet
#   bing          proven; carried the whole rebuild alone while yep and duckduckgo were blocked
#   zapmeta, dogpile, abcnyheter   Yahoo Finance plus some social noise — usable filler
#   yep, duckduckgo   blocked at time of writing, but both RECOVER; kept so they rejoin on their own
#
# Blocked engines are operators refusing automated access; that refusal is respected rather than
# worked around. Small sets also help twice: fewer blocked engines AND less per-query load, which
# is itself part of what provokes the blocking.
use_default_settings:
  engines:
    keep_only:
      - bing
      - dogpile news
      - gabanza
      - yandex
      - zapmeta
      - dogpile
      - abcnyheter
      - yep
      - duckduckgo
engines:
  - name: bing
    disabled: false
  - name: dogpile news
    disabled: false
  - name: gabanza
    disabled: false
  - name: yandex
    disabled: false
  - name: zapmeta
    disabled: false
  - name: dogpile
    disabled: false
  - name: abcnyheter
    disabled: false
  - name: yep
    disabled: false
  - name: duckduckgo
    disabled: false
server:
  secret_key: "REPLACE_ME_WITH_A_RANDOM_64_HEX_STRING"
  limiter: false
  image_proxy: false
search:
  safe_search: 0
  # Without this the instance geo-resolves and returns locale noise useless for US equity
  # research: "Bunge farm products outlook 2026" led with a YouTube help page and a zhihu
  # thread, "realty income dividend 2026" with Taiwanese property portals.
  default_lang: "en-US"
  formats:
    - html
    - json
